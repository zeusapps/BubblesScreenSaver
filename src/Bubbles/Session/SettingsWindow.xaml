<Window x:Class="Bubbles.Session.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bubbles settings"
        Width="620"
        Height="820"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True">

    <!-- Sizes are in device-independent units throughout. app.manifest declares per-monitor DPI
         awareness, so a hard-coded pixel size would be wrong on every display but one.

         An explicit Height rather than SizeToContent with a MaxHeight: that pair caps a
         *maximized* window too, so maximizing produced a window that did not fill the screen and
         did not look deliberate either. The scroll viewer already handles content taller than
         the window, which is what SizeToContent was standing in for. -->

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="10,8,10,10" />
        </Style>
        <Style x:Key="BaseText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}" />
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
        </Style>
        <!-- A caption under a control, for the things that need a sentence rather than a label. -->
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,2,0,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- A theme is picked by looking, so it is picked from pictures rather than from a list
             of names. Built on RadioButton rather than on a bare Border so the group still
             answers to the keyboard and to a screen reader: arrow keys move between the cards,
             space selects, and the selection is reported as a selection.

             The image sits flush to the top edge under a clipped, rounded surface, which is the
             card shape this is modelled on. -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Shadow" BlurRadius="6" ShadowDepth="1"
                                                  Direction="270" Opacity="0.16" Color="Black" />
                            </Border.Effect>

                            <!-- Clipped to the same radius, so the image corners follow the
                                 card instead of squaring it off. -->
                            <Border CornerRadius="8" ClipToBounds="True">
                                <Border.Clip>
                                    <RectangleGeometry RadiusX="8" RadiusY="8"
                                                       Rect="0,0,250,320" />
                                </Border.Clip>
                                <StackPanel>
                                    <ContentPresenter />
                                </StackPanel>
                            </Border>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- A form is read in a column. Left to itself the rows stretch to whatever width the window
         has, and maximizing on a wide monitor gave delay dropdowns some two thousand pixels long
         with their labels stranded at the far left. The content keeps a readable width and the
         window may be as wide as it likes around it.

         Centred rather than left, so a maximized window looks like a decision rather than like a
         form that failed to fill it. -->
    <DockPanel Margin="14" MaxWidth="620" HorizontalAlignment="Center">
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
            <Grid>
                <!-- Restore defaults sits apart from Cancel: one returns to how the app shipped,
                     the other to how it was a minute ago, and confusing them is expensive. -->
                <Button x:Name="DefaultsButton" Content="Restore defaults" HorizontalAlignment="Left"
                        Padding="12,5" Click="OnRestoreDefaults" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Padding="14,5" Margin="0,0,8,0"
                            Click="OnCancel"
                            ToolTip="Undo everything changed since this window was opened" />
                    <Button x:Name="CloseButton" Content="Close" Padding="14,5" IsDefault="True"
                            Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}"
                   Text="Changes apply straight away. Anything you can see only while the screensaver is running takes effect the next time it starts, because it is held off while this window is open." />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel x:Name="Groups" />
        </ScrollViewer>
    </DockPanel>
</Window>
