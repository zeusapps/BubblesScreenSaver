<Window x:Class="Bubbles.Session.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bubbles settings"
        SizeToContent="Height"
        Width="560"
        MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True">

    <!-- Sizes are in device-independent units throughout, and the height follows the content.
         app.manifest declares per-monitor DPI awareness, so a hard-coded pixel height would be
         wrong on every display but one. -->

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="10,8,10,10" />
        </Style>
        <Style x:Key="BaseText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}" />
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
        </Style>
        <!-- A caption under a control, for the things that need a sentence rather than a label. -->
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,2,0,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
            <Grid>
                <!-- Restore defaults sits apart from Cancel: one returns to how the app shipped,
                     the other to how it was a minute ago, and confusing them is expensive. -->
                <Button x:Name="DefaultsButton" Content="Restore defaults" HorizontalAlignment="Left"
                        Padding="12,5" Click="OnRestoreDefaults" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Padding="14,5" Margin="0,0,8,0"
                            Click="OnCancel"
                            ToolTip="Undo everything changed since this window was opened" />
                    <Button x:Name="CloseButton" Content="Close" Padding="14,5" IsDefault="True"
                            Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}"
                   Text="Changes apply straight away. Anything you can see only while the screensaver is running takes effect the next time it starts, because it is held off while this window is open." />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel x:Name="Groups" />
        </ScrollViewer>
    </DockPanel>
</Window>
