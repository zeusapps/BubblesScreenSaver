<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bubbles</AssemblyName>
    <Version>1.0.0</Version>
    <Company>zeusapps</Company>
    <Product>Bubbles</Product>
    <Description>A transparent, click-through screensaver replacement for Windows.</Description>
    <RepositoryUrl>https://github.com/zeusapps/BubblesScreenSaver</RepositoryUrl>
    <RootNamespace>Bubbles</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Do NOT set InvariantGlobalization: WPF text layout constructs CultureInfo("en")
         while measuring a TextBlock, which throws under invariant mode. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WinForms nags about DPI in the manifest; this app is WPF-first and needs it there. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project reaches a few internals that are not worth making public just to
         exercise them. See tests/Bubbles.Tests. -->
    <InternalsVisibleTo Include="Bubbles.Tests" />
  </ItemGroup>

  <!-- `dotnet publish -c Release` drops a single Bubbles.exe in dist\.
       Framework-dependent on purpose: this thing runs 24/7, and bundling the runtime
       costs ~75 MB of resident memory (single-file compression has to inflate the whole
       bundle into the process). Add -p:SelfContained=true for a machine without .NET 10. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishDir>dist\</PublishDir>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
